# Root directory that contains projects managed by Dev HQ.
# Windows example: <USER_HOME>\Projects
# macOS/Linux example: <USER_HOME>/Projects
DEV_HQ_PROJECTS_ROOT=

# Optional watchdog settings
DEV_HQ_WATCHDOG_PORT=32110
DEV_HQ_DESKTOP_CONTROL_PORT=32103
DEV_HQ_WATCH_DESKTOP_COMMANDER=false

# Optional comma-separated tool health checks.
# Format: Name:port,Another Tool:port
DEV_HQ_TOOL_PORTS=
